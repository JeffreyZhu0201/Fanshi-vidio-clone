NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5173
HTTPS_ENABLED=false
HTTPS_PORT=5443
SSL_KEY_PATH=../certs/dev/localhost-key.pem
SSL_CERT_PATH=../certs/dev/localhost.pem
HTTP_REDIRECT_TO_HTTPS=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=fanshi_video_db
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_CONNECT_TIMEOUT=10000
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_AUTO_CREATE=true
UPLOAD_BASE_DIR=

GEMINI_API_KEY=
GEMINI_API_BASE_URL=
GEMINI_MODEL=gemini-1.5-flash
SEED_DANCE_API_KEY=
SEED_DANCE_API_BASE_URL=
SEED_DANCE_MODEL=seed-dance-v1
EXTERNAL_REQUEST_TIMEOUT=30000
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
JWT_SECRET=replace-with-a-long-random-secret
FILE_UPLOAD_LIMIT=524288000
