{
  "name": "fanshi-video-clone-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend service for Fanshi AI video clone project.",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "check": "node --check server.js",
    "db:check": "node scripts/db-check.js",
    "db:init": "node utils/dbInit.js",
    "db:sync": "node utils/dbInit.js --alter",
    "db:migrate": "sequelize-cli db:migrate --config config/sequelize-cli.cjs --migrations-path migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config config/sequelize-cli.cjs --migrations-path migrations",
    "db:seed": "sequelize-cli db:seed:all --config config/sequelize-cli.cjs --seeders-path seeders"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.3",
    "sequelize": "^6.37.3",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "sequelize-cli": "^6.6.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
