{
  "name": "fanshi-video-clone-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend workspace for Fanshi AI video clone project.",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "cypress:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "cypress:run": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "test:e2e": "start-server-and-test dev:test http://127.0.0.1:4173 cypress:run"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@tailwindcss/forms": "^0.5.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^30.0.5",
    "babel-preset-vite": "^1.1.3",
    "cypress": "^15.13.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "postcss": "^8.4.47",
    "start-server-and-test": "^3.0.2",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
